+}
+
+uint32_t RuntimeImpl::read_main_ram_word(uint32_t address) const {
+    if ((address & 3u) || address < 0x02000000u || address >= 0x02400000u) return 0;
+    const auto* page = read_pages_[address >> NTR_PAGE_SHIFT];
+    uint32_t value = 0;
+    if (page) NTR_MEMCPY(&value, page + (address & NTR_PAGE_MASK), sizeof(value));
+    return value;
 }
 
