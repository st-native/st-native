+void Mic_Start(void* userdata) {
+    if (userdata) static_cast<ntr::RuntimeImpl*>(userdata)->host.on_mic_start();
+}
+void Mic_Stop(void* userdata) {
+    if (userdata) static_cast<ntr::RuntimeImpl*>(userdata)->host.on_mic_stop();
+}
+int Mic_ReadInput(s16* data, int maxlength, void* userdata) {
+    if (!userdata || !data || maxlength <= 0) return 0;
+    return int(static_cast<ntr::RuntimeImpl*>(userdata)->host.on_mic_read(data, size_t(maxlength)));
+}
