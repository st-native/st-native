+const char* kCinematicVS = R"(#version 140
+in vec2 vPos;
+out vec2 fUv;
+void main() {
+    gl_Position = vec4(vPos * 2.0 - 1.0, 0.0, 1.0);
+    fUv = vPos;
+}
+)";
+
+const char* kCinematicFS = R"(#version 140
+uniform sampler2D uTex;
+uniform int uMode;
+uniform int uBrightMode;
+uniform int uBrightFactor;
+in vec2 fUv;
+out vec4 oColor;
+
+ivec3 apply_brightness(ivec3 c) {
+    if (uBrightMode == 1) c += ((63 - c) * uBrightFactor) >> 4;
+    else if (uBrightMode == 2) c -= (c * uBrightFactor) >> 4;
+    return (c << 2) | (c >> 4);
+}
+
+void main() {
+    if (uMode == 3) {
+        vec4 ov = texture(uTex, fUv);
+        if (ov.a < 0.5) discard;
+        oColor = vec4(ov.rgb, 1.0);
+        return;
+    }
+    ivec4 raw = ivec4(texture(uTex, fUv) * 255.0 + 0.5);
+    if (uMode == 1) {
+        int a = (raw.a >> 3) & 31;
+        if (a == 0) discard;
+        oColor = vec4(vec3(apply_brightness(raw.rgb >> 2)) / 255.0, float(a + 1) / 32.0);
+        return;
+    }
+    if (uMode == 2 && raw.a == 0) discard;
+    oColor = vec4(vec3(apply_brightness(raw.rgb >> 2)) / 255.0, 1.0);
+}
+)";
