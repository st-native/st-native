+GlCinematic::~GlCinematic() {
+    release();
+    if (vbo_) glDeleteBuffers(1, &vbo_);
+    if (vao_) glDeleteVertexArrays(1, &vao_);
+    if (prog_) glDeleteProgram(prog_);
+}
+
+void GlCinematic::release() {
+    GLuint textures[5] = {saved_3d_, out_tex_, raw_2d_tex_, overlay_tex_[0], overlay_tex_[1]};
+    GLuint fbs[6] = {out_fb_, raw_2d_fb_, read_fb_, draw_fb_, overlay_fb_[0], overlay_fb_[1]};
+    if (saved_3d_ || out_tex_) glDeleteTextures(5, textures);
+    if (out_fb_ || read_fb_) glDeleteFramebuffers(6, fbs);
+    saved_3d_ = out_tex_ = raw_2d_tex_ = overlay_tex_[0] = overlay_tex_[1] = 0;
+    out_fb_ = raw_2d_fb_ = read_fb_ = draw_fb_ = overlay_fb_[0] = overlay_fb_[1] = 0;
+    w_ = h_ = 0;
+    last_frame_ = 0;
+}
+
+bool GlCinematic::ensure_pipeline() {
+    if (prog_) return true;
+    GLuint prog = 0;
+    if (!melonDS::OpenGL::CompileVertexFragmentProgram(prog, kCinematicVS, kCinematicFS, "CinematicCompose",
+                                                       {{"vPos", 0}}, {{"oColor", 0}}))
+        return false;
+    prog_ = prog;
+    u_tex_ = glGetUniformLocation(prog, "uTex");
+    u_mode_ = glGetUniformLocation(prog, "uMode");
+    u_bright_mode_ = glGetUniformLocation(prog, "uBrightMode");
+    u_bright_factor_ = glGetUniformLocation(prog, "uBrightFactor");
+
+    const float quad[] = {0.f, 0.f, 1.f, 0.f, 0.f, 1.f, 1.f, 1.f};
+    glGenBuffers(1, &vbo_);
+    glBindBuffer(GL_ARRAY_BUFFER, vbo_);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW);
+    glGenVertexArrays(1, &vao_);
+    glBindVertexArray(vao_);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, nullptr);
+    glBindVertexArray(0);
+    return true;
+}
+
+void GlCinematic::ensure_size(int w, int h) {
+    if (w == w_ && h == h_) return;
+    release();
+    w_ = w;
+    h_ = h;
+    GLuint t[5]{}, f[6]{};
+    glGenTextures(5, t);
+    glGenFramebuffers(6, f);
+    saved_3d_ = t[0];
+    out_tex_ = t[1];
+    raw_2d_tex_ = t[2];
+    overlay_tex_[0] = t[3];
+    overlay_tex_[1] = t[4];
+    out_fb_ = f[0];
+    raw_2d_fb_ = f[1];
+    read_fb_ = f[2];
+    draw_fb_ = f[3];
+    overlay_fb_[0] = f[4];
+    overlay_fb_[1] = f[5];
+    for (GLuint tex : t) init_rgba_tex(tex, w, h);
+    attach_color0(out_fb_, out_tex_);
+    attach_color0(raw_2d_fb_, raw_2d_tex_);
+    attach_color0(overlay_fb_[0], overlay_tex_[0]);
+    attach_color0(overlay_fb_[1], overlay_tex_[1]);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+}
+
+uint32_t GlCinematic::render(melonDS::GLRenderer& r, melonDS::NDS& nds, gx::Streams& streams,
+                             double aspect, CinematicUiPlacement ui, CinematicCamera camera, uint64_t frame) {
+    const GLuint tex3d = r.*get(Output3D{});
+    GLint w = 0, h = 0;
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, tex3d);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &w);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &h);
+    if (w <= 0 || h <= 0 || !ensure_pipeline()) return 0;
+    ensure_size(w, h);
+
+    auto draw_quad = [&](GLuint fb, GLuint src_tex, int mode, uint16_t brightness,
+                         int vx, int vy, int vw, int vh, bool blend) {
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fb);
+        glDisable(GL_DEPTH_TEST);
+        glDisable(GL_STENCIL_TEST);
+        glDisable(GL_SCISSOR_TEST);
+        glDisable(GL_CULL_FACE);
+        glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+        if (blend) {
+            glEnable(GL_BLEND);
+            glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+        } else {
+            glDisable(GL_BLEND);
+        }
+        glViewport(vx, vy, vw, vh);
+        glUseProgram(prog_);
+        glUniform1i(u_tex_, 0);
+        glUniform1i(u_mode_, mode);
+        glUniform1i(u_bright_mode_, int((brightness >> 14) & 3));
+        glUniform1i(u_bright_factor_, std::min<int>(brightness & 31, 16));
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, src_tex);
+        glBindVertexArray(vao_);
+        glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    };
+
+    copy_texture(read_fb_, draw_fb_, tex3d, saved_3d_, w, h);
+    const int scale = std::max(1, w / 256);
+    const CinematicUiPlacement p = valid_cinematic_ui_placement(ui) ? ui : CinematicUiPlacement{};
+    const bool rendered = streams.render_cinematic(aspect, [&](bool overlay) {
+        r.Start3DRendering();
+        if (!overlay) {
+            draw_quad(out_fb_, tex3d, 0, nds.GPU.MasterBrightnessA, 0, 0, w, h, false);
+        } else {
+            draw_quad(out_fb_, tex3d, 1, nds.GPU.MasterBrightnessA,
+                      p.x * scale, p.y * scale, p.width * scale, p.height * scale, true);
+        }
+    }, camera);
+    copy_texture(read_fb_, draw_fb_, saved_3d_, tex3d, w, h);
+    if (!rendered) {
+        glDisable(GL_BLEND);
+        glUseProgram(0);
+        glBindVertexArray(0);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        return 0;
+    }
+
+    const int cur = overlay_cur_;
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, overlay_fb_[cur]);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glClearColor(0.f, 0.f, 0.f, 0.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+
+    for (unsigned screen = 0; screen < 2; ++screen) {
+        const int eng_num = nds.GPU.ScreenSwap ? int(screen) : int(1 - screen);
+        const auto& gpu2d = eng_num ? nds.GPU.GPU2D_B : nds.GPU.GPU2D_A;
+        const uint32_t dispmode = (gpu2d.DispCnt >> 16) & (eng_num ? 1u : 3u);
+        if (!nds.GPU.ScreensEnabled || !gpu2d.Enabled || gpu2d.ForcedBlank || dispmode != 1) continue;
+
+        auto& eng_gl = static_cast<melonDS::GLRenderer2D&>(*(eng_num ? r.*get(Engine2DB{}) : r.*get(Engine2DA{})));
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, raw_2d_fb_);
+        glDisable(GL_SCISSOR_TEST);
+        glClearColor(0.f, 0.f, 0.f, 0.f);
+        glClear(GL_COLOR_BUFFER_BIT);
+
+        const GLuint comp_prog = eng_gl.*get(CompositorProg{});
+        const GLint u_ov = glGetUniformLocation(comp_prog, "uOverlayOnly");
+        glUseProgram(comp_prog);
+        glUniform1i(u_ov, 1);
+        GLuint& own_fb = eng_gl.*get(OutputFB2D{});
+        const GLuint prev_fb = own_fb;
+        own_fb = raw_2d_fb_;
+        (eng_gl.*get(Composite2D{}))(0, 192);
+        own_fb = prev_fb;
+        glUseProgram(comp_prog);
+        glUniform1i(u_ov, 0);
+
+        const uint16_t bright = eng_num ? nds.GPU.MasterBrightnessB : nds.GPU.MasterBrightnessA;
+        draw_quad(overlay_fb_[cur], raw_2d_tex_, 2, bright, 0, 0, w, h, false);
+    }
+
+    if (last_frame_ + 1 == frame)
+        draw_quad(out_fb_, overlay_tex_[1 - cur], 3, 0, 0, 0, w, h, false);
+    draw_quad(out_fb_, overlay_tex_[cur], 3, 0, 0, 0, w, h, false);
+    last_frame_ = frame;
+    overlay_cur_ = 1 - cur;
+
+    glDisable(GL_BLEND);
+    glDisable(GL_SCISSOR_TEST);
+    glUseProgram(0);
+    glBindVertexArray(0);
+    glActiveTexture(GL_TEXTURE0);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    return out_tex_;
+}
+
 }  // namespace ntr
