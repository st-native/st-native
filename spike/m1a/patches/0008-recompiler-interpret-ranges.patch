                                      ": expected '<module> <addr> replace|before|instead <c_function>'");
         cfg.hooks.push_back({m->id, uint32_t(std::stoul(addr, nullptr, 16)), repl, kind == "before", kind == "instead"});
     }
+
+    // interpret.txt (optional): '<module> <addr> <size>' ranges of guest code that are never recompiled.
+    std::ifstream in(dir / "interpret.txt");
+    lineno = 0;
+    while (in && std::getline(in, line)) {
+        lineno++;
+        line = trim(line);
+        if (line.empty()) continue;
+        std::istringstream ss(line);
+        std::string mod, addr, size;
+        ss >> mod >> addr >> size;
+        const Module* m = program.module_by_name(mod);
+        if (!m || size.empty())
+            throw std::runtime_error("interpret.txt:" + std::to_string(lineno) + ": expected '<module> <addr> <size>'");
+        cfg.interpret.push_back({m->id, uint32_t(std::stoul(addr, nullptr, 16)), uint32_t(std::stoul(size, nullptr, 16))});
+    }
     return cfg;
 }
 
+bool Config::interpreted(int module, uint32_t addr) const {
+    for (const InterpretRange& r : interpret)
+        if (r.module == module && addr >= r.addr && addr - r.addr < r.size) return true;
+    return false;
+}
+
 }  // namespace recomp
