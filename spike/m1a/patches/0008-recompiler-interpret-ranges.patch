     bool instead = false;     // call it on entry; it returns nonzero if it did the call, 0 to run the recompiled body
 };
 
+// interpret.txt: guest code that is never recompiled, even when called directly. Calls and jumps to it go through
+// the runtime (ntr_call / ntr_jump), which finds no recompiled function there and runs it on the interpreter. For
+// code whose bytes in the ROM are not what runs (e.g. routines a game decrypts in place before calling them).
+struct InterpretRange {
+    int module = 0;
+    uint32_t addr = 0, size = 0;
+};
+
 struct Config {
     std::vector<FunctionSeed> functions;
     std::vector<Hook> hooks;
+    std::vector<InterpretRange> interpret;
+
+    bool interpreted(int module, uint32_t addr) const;
 };
 
 struct Program {
