diff --git a/runtime/include/ntr/runtime.hpp b/runtime/include/ntr/runtime.hpp
--- a/runtime/include/ntr/runtime.hpp
+++ b/runtime/include/ntr/runtime.hpp
@@ -77,6 +77,8 @@
     double emu_ms = 0;               // host time spent emulating this frame (not the frontend's pacing or presenting)
