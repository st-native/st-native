+// Projection offsets in SDK 20.12 units, for a host-verified pair of parallel frustums.
+// The legacy default infers a symmetric pair from each nonzero offset. Explicit spans also
+// support a centered world half, which must not be classified as screen-space perspective UI.
+struct CinematicCamera {
+    bool explicit_span = false;
+    int32_t min_offset_y = 0, max_offset_y = 0;
+    bool centered_perspective_is_ui = true;
+};
+
+constexpr bool valid_cinematic_camera(CinematicCamera camera) {
+    return !camera.explicit_span || (camera.min_offset_y < camera.max_offset_y &&
+        camera.min_offset_y >= -8 * 4096 && camera.max_offset_y <= 8 * 4096);
+}
+
