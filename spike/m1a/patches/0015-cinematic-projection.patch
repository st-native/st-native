+bool Streams::render_cinematic(double aspect, const std::function<void(bool)>& render) {
+    if (!have_prev_ || !prev_flushed_ || prev_.start.empty() || restore_pending_) return false;
+    auto entries = prev_.entries;
+    if (!center_split_projection(entries, aspect)) return false;
+    const auto original = check ? hash_render_list(g_) : 0;
+    const bool identical = g_.RenderFrameIdentical;
+    replay(prev_, entries, 1);
+    render(false);
+    restore_real();
+    restore_pending_ = false;
+    // Screen-space 3D UI can exist only on one of two alternating screen scenes. Use the freshest
+    // scene containing that UI, expiring it with the next pair so a removed logo cannot linger.
+    const Scene* ui = nullptr;
+    if (has_centered_projection(prev_.entries)) ui = &prev_;
+    else if (have_older_ && prev_.vblank - older_.vblank <= 2 &&
+             has_centered_projection(older_.entries)) ui = &older_;
+    if (ui) {
+        replay(*ui, ui->entries, 2);
+        const auto clear = g_.RenderClearAttr1;
+        const auto control = g_.RenderDispCnt;
+        g_.RenderClearAttr1 = 0;
+        g_.RenderDispCnt &= ~(1u << 14); // transparent clear, without the rear-plane bitmap
+        render(true);
+        g_.RenderClearAttr1 = clear;
+        g_.RenderDispCnt = control;
+        restore_real();
+        restore_pending_ = false;
+    }
+    g_.RenderFrameIdentical = identical;
+    if (check) {
+        ++checked_;
+        check_failed_ += hash_render_list(g_) != original;
+    }
+    return true;
+}
