+
+void RuntimeImpl::capture_overlay_line(void* context, const melonDS::GPU2D& engine, u32 line,
+                                       const u32* foreground, const u32* composite) {
+    if (!context || line >= 192) return;
+    auto& runtime = *static_cast<RuntimeImpl*>(context);
+    if (!runtime.options.cinematic_camera) return;
+    const auto& gpu = runtime.nds->GPU;
+    const unsigned screen = gpu.ScreenSwap ? engine.Num : 1 - engine.Num;
+    auto* output = runtime.overlay_pixels_[screen].data() + line * 256;
+    const auto brightness = engine.Num ? gpu.MasterBrightnessB : gpu.MasterBrightnessA;
+    for (unsigned x = 0; x < 256; ++x)
+        output[x] = cinematic_overlay_pixel(foreground[x] >> 24, engine.DispCnt & 7,
+                                            engine.BGCnt[2], engine.BGCnt[3])
+            ? cinematic_argb6(composite[x], brightness) : 0;
