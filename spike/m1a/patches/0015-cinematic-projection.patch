+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+namespace ntr {
+
+// Destination for screen-space 3D UI in the optional 256x192 cinematic image.
+// Identity by default. Neither the world camera nor either original DS image is transformed.
+struct CinematicUiPlacement {
+    int x = 0, y = 0, width = 256, height = 192;
+};
+
+constexpr bool valid_cinematic_ui_placement(CinematicUiPlacement p) {
+    return p.x >= 0 && p.y >= 0 && p.width > 0 && p.height > 0 &&
+        p.x <= 256 && p.y <= 192 && p.width <= 256 - p.x && p.height <= 192 - p.y;
+}
+
+} // namespace ntr
