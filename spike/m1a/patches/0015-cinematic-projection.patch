+// In a host-verified split-camera composition, treat centered projections as screen-space UI.
+// This is not a scene detector; the host must opt in only where that interpretation is valid.
+inline bool centered_projection_at(const std::vector<Entry>& entries, size_t i) {
+    return i + 16 <= entries.size() && entries[i].op == 0x16 && entries[i + 9].param == 0 &&
+        ((entries[i + 11].param == 0 && entries[i + 15].param != 0) ||
+         (entries[i + 15].param == 0 && int32_t(entries[i + 11].param) < 0));
+}
+
+inline bool has_centered_projection(const std::vector<Entry>& entries) {
+    uint32_t mode = 0;
+    for (size_t i = 0; i < entries.size();) {
+        const auto count = size_t(entry_count(entries[i].op));
+        if (i + count > entries.size()) return false;
+        if (entries[i].op == 0x10) mode = entries[i].param & 3;
+        if (mode == 0 && centered_projection_at(entries, i)) return true;
+        i += count;
+    }
+    return false;
+}
+
+// A pair of off-axis frusta covers [-1-offset, 1+offset] vertically. Recenter the perspective
+// and include that complete extent, with the horizontal focal length derived from the target aspect.
+inline bool center_split_projection(std::vector<Entry>& entries, double aspect) {
+    if (!std::isfinite(aspect) || aspect < 0.5 || aspect > 4.0) return false;
+    uint32_t mode = 0;
+    bool changed = false;
+    for (size_t i = 0; i < entries.size();) {
+        const auto op = entries[i].op;
+        const size_t count = size_t(entry_count(op));
+        if (i + count > entries.size()) return false;
+        if (op == 0x10) mode = entries[i].param & 3;
+        if (mode == 0 && op == 0x16) {
+            const auto signed_param = [&](size_t index) { return int32_t(entries[i + index].param); };
+            if (signed_param(11) == -4096 && signed_param(15) == 0 && signed_param(9) != 0 &&
+                signed_param(0) > 0 && signed_param(5) > 0) {
+                const double height = 1.0 + std::abs(double(signed_param(9))) / 4096.0;
+                const auto vertical = int32_t(std::lround(signed_param(5) / height));
+                entries[i].param = uint32_t(int32_t(std::lround(vertical / aspect)));
+                entries[i + 5].param = uint32_t(vertical);
+                entries[i + 8].param = entries[i + 9].param = 0;
+                changed = true;
+            }
+        }
+        i += count;
+    }
+    return changed;
+}
