+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+#include "ntr/cinematic.hpp"
+
+namespace ntr {
+
+// Provenance bits supplied by the software 2D compositor, before master brightness.
+// The captured 3D view can be displayed as a bitmap BG or bitmap OBJ. Neither belongs
+// over a separately rerendered camera. Text BGs and ordinary/palette OBJ do.
+inline bool cinematic_overlay_pixel(unsigned flag, unsigned mode, unsigned bg2, unsigned bg3) {
+    if (flag & 0x40) return false; // live 3D or direct-color bitmap OBJ
+    if (flag & 0x90) return true; // opaque or translucent palette OBJ
+    unsigned bitmap = 0;
+    if (mode >= 3 && mode <= 5 && (bg3 & 0x80)) bitmap |= 8;
+    if ((mode == 5 && (bg2 & 0x80)) || mode == 6) bitmap |= 4;
+    return (flag & 15 & ~bitmap) != 0;
+}
+
+inline uint32_t cinematic_argb6(uint32_t color, unsigned brightness) {
+    const unsigned strength = std::min(brightness & 31, 16u);
+    const auto expand = [brightness, strength](uint32_t c) {
+        if ((brightness >> 14) == 1) c += ((63 - c) * strength) >> 4;
+        if ((brightness >> 14) == 2) c -= (c * strength) >> 4;
+        return (c << 2) | (c >> 4);
+    };
+    return 0xff000000u | (expand(color & 63) << 16) |
+        (expand((color >> 8) & 63) << 8) | expand((color >> 16) & 63);
+}
+
+// Apply placement only to the separately rendered 3D UI, preserving transparent pixels.
+// Source pixels use the DS renderer's 6-bit RGB / 5-bit alpha format. Nearest sampling keeps
+// the pixel-art treatment consistent with the current 1x renderer. Invalid placement is identity.
+template <typename LineReader>
+void composite_cinematic_ui(uint32_t* destination, LineReader read_line,
+                            CinematicUiPlacement placement, unsigned brightness) {
+    if (!valid_cinematic_ui_placement(placement)) placement = {};
+    for (int y = 0; y < placement.height; ++y) {
+        const auto* source = read_line((2 * y + 1) * 192 / (2 * placement.height));
+        for (int x = 0; x < placement.width; ++x) {
+            const auto color = source[(2 * x + 1) * 256 / (2 * placement.width)];
+            const unsigned alpha = (color >> 24) & 31;
+            if (!alpha) continue;
+            const auto pixel = cinematic_argb6(color, brightness);
+            auto& output = destination[(y + placement.y) * 256 + x + placement.x];
+            const unsigned weight = alpha + 1;
+            const auto blend = [weight](unsigned a, unsigned b) {
+                return (a * weight + b * (32 - weight)) >> 5;
+            };
+            output = 0xff000000u | (blend((pixel >> 16) & 255, (output >> 16) & 255) << 16) |
+                (blend((pixel >> 8) & 255, (output >> 8) & 255) << 8) | blend(pixel & 255, output & 255);
+        }
+    }
+}
