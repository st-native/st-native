+class CinematicRenderer final : public melonDS::SoftRenderer {
+public:
+    explicit CinematicRenderer(melonDS::NDS& nds) : SoftRenderer(nds), pixels_(256 * 192) { Reset(); }
+
+    const uint32_t* render(bool overlay, CinematicUiPlacement ui) {
+        Start3DRendering();
+        Finish3DRendering();
+        const auto brightness = GPU.MasterBrightnessA;
+        if (overlay) {
+            composite_cinematic_ui(pixels_.data(), [&](int y) { return Rend3D->GetLine(y); }, ui, brightness);
+        } else {
+            for (int y = 0; y < 192; ++y) {
+                const auto* line = Rend3D->GetLine(y);
+                for (int x = 0; x < 256; ++x)
+                    pixels_[size_t(y) * 256 + x] = cinematic_argb6(line[x], brightness);
+            }
+        }
+        return pixels_.data();
+    }
+
+    const uint32_t* add_overlays(const std::array<std::vector<uint32_t>, 2>& overlays) {
+        for (const auto& overlay : overlays)
+            for (size_t i = 0; i < pixels_.size(); ++i)
+                if (overlay[i] >> 24) pixels_[i] = overlay[i];
+        return pixels_.data();
+    }
+
+private:
+    std::vector<uint32_t> pixels_;
+};
 
