 // Calls
+
+GraphicsContext RuntimeImpl::inspect_graphics() const {
+    GraphicsContext result = gx_ ? gx_->graphics_context() : GraphicsContext{};
+    const auto& gpu = nds->GPU;
+    result.screen_swap = gpu.ScreenSwap;
+    result.capture_control = gpu.CaptureCnt;
+    for (unsigned e = 0; e < 2; ++e) {
+        const auto& display = e == 0 ? gpu.GPU2D_A : gpu.GPU2D_B;
+        result.display_control[e] = display.DispCnt;
+        for (unsigned bg = 0; bg < 4; ++bg) {
+            result.bg_control[e * 4 + bg] = display.BGCnt[bg];
+            result.scroll_x[e * 4 + bg] = display.BGXPos[bg];
+            result.scroll_y[e * 4 + bg] = display.BGYPos[bg];
+        }
+        for (unsigned bg = 0; bg < 2; ++bg) {
+            const auto index = e * 2 + bg;
+            result.reference_x[index] = display.BGXRef[bg];
+            result.reference_y[index] = display.BGYRef[bg];
+            result.affine[index * 4] = display.BGRotA[bg];
+            result.affine[index * 4 + 1] = display.BGRotB[bg];
+            result.affine[index * 4 + 2] = display.BGRotC[bg];
+            result.affine[index * 4 + 3] = display.BGRotD[bg];
+        }
+    }
+    return result;
+}
 
