+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace ntr {
+
+// Read-only diagnostics, not a scene classifier. Counts describe explicit projection loads
+// in the latest completed GX stream; the host must also check whether/when 3D is displayed.
+struct ProjectionSummary {
+    uint32_t perspective_positive_y = 0, perspective_negative_y = 0, perspective_centered = 0;
+    uint32_t orthographic = 0, other = 0;
+    bool complete = true;
+};
+
+struct GraphicsContext {
+    uint64_t geometry_frame = 0;
+    // Effective projection and model-view signature at the first perspective primitive.
+    int32_t focal_x = 0, focal_y = 0, offset_y = 0;
+    uint64_t first_view_hash = 0;
+    ProjectionSummary projection;
+    bool screen_swap = false;
+    uint32_t capture_control = 0;
+    std::array<uint32_t, 2> display_control{};
+    // Engine A's four BGs, then engine B's four BGs; SDK register values only.
+    std::array<uint16_t, 8> bg_control{}, scroll_x{}, scroll_y{};
+    // A BG2/BG3, B BG2/BG3. Each affine transform is A/B/C/D in order.
+    std::array<int32_t, 4> reference_x{}, reference_y{};
+    std::array<int16_t, 16> affine{};
+};
+
+} // namespace ntr
