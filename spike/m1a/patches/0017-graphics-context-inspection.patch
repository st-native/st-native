+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include "gx_match.hpp"
+#include "ntr/graphics_context.hpp"
+
+namespace ntr::gx {
+
+inline ProjectionSummary inspect_projections(const std::vector<Entry>& entries) {
+    ProjectionSummary result;
+    // A retained stream may start midway through matrix state. Count only loads whose mode was explicit here.
+    uint32_t mode = ~uint32_t(0);
+    for (size_t i = 0; i < entries.size();) {
+        const auto count = size_t(entry_count(entries[i].op));
+        if (i + count > entries.size()) { result.complete = false; return result; }
+        if (entries[i].op == 0x10) mode = entries[i].param & 3;
+        if (mode == 0 && entries[i].op == 0x16) {
+            const auto w = int32_t(entries[i + 11].param);
+            const auto last = int32_t(entries[i + 15].param);
+            const auto offset = int32_t(entries[i + 9].param);
+            if (w < 0 && last == 0) {
+                if (offset > 0) ++result.perspective_positive_y;
+                else if (offset < 0) ++result.perspective_negative_y;
+                else ++result.perspective_centered;
+            } else if (w == 0 && last != 0) ++result.orthographic;
+            else ++result.other;
+        }
+        i += count;
+    }
+    return result;
+}
+
+} // namespace ntr::gx
