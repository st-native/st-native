<rml>
<head>
  <link type="text/rcss" href="launcher.rcss" />
  <style>
    body { background-color: #10171788; display: flex; align-items: center; justify-content: center; }
    body.paused { background-color: #101717c9; }
    #pause-panel { box-sizing: border-box; width: 452dp; max-width: 94%; max-height: 94%; overflow-y: auto;
                   padding: 16dp 20dp; background-color: #171e1e;
                   border: 1dp #52645a; border-radius: 6dp; }
    #pause-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14dp; }
    #pause-heading-actions { display: flex; align-items: center; }
    #classic-shortcut { color: #b3c0b8; font-size: 15dp; margin-right: 12dp; }
    #pause-mode { width: auto; height: 32dp; line-height: 30dp; padding: 0 11dp; font-size: 15dp; }
    #pause-mode.active { border-color: #aabda6; background-color: #41584d; }
    #pause-panel > input { width: 100%; }
    #pause-panel .settings-page { min-height: 92dp; margin-bottom: 12dp; }
    #pause-panel .settings-tabs input { flex: 1 0 auto; margin-bottom: 5dp; }
    #pause-panel #settings-audio select, #pause-panel .range-group { flex-basis: 220dp; }
    #display-row, #layout-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10dp; }
    #display-row input { width: 112dp; }
    #resume { background-color: #c7dbb9; border-color: #c7dbb9; color: #18231d; margin-bottom: 8dp; }
    #resume:hover { background-color: #dfebd5; }
    #resume:focus { border-color: #eed08c; }
  </style>
</head>
<body>
  <div id="pause-panel">
    <div id="pause-heading">
      <h2 id="pause-title">Menu</h2>
      <div id="pause-heading-actions">
        <p id="classic-shortcut">F2 · Original view</p>
        <input type="submit" id="pause-mode" value="Pause game: Off" />
      </div>
    </div>
    <div class="settings-tabs">
      <input type="submit" id="tab-screens" class="selected" value="Screens" />
      <input type="submit" id="tab-map" value="Map" />
            <input type="submit" id="tab-features" value="Screen features" />
      <input type="submit" id="tab-audio" value="Audio" />
      <input type="submit" id="tab-graphics" value="Graphics" />
      <input type="submit" id="tab-controls" value="Controls" />
      <input type="submit" id="tab-window" value="Window" />
    </div>
    <div id="settings-graphics" class="settings-page">
      <div class="field">
        <label for="pause-internal-resolution">Internal resolution</label>
        <select id="pause-internal-resolution">
          <option value="256x192">256x192 (Native)</option>
          <option value="512x384">512x384</option>
          <option value="768x576">768x576</option>
          <option value="1024x768">1024x768</option>
          <option value="1280x960">1280x960</option>
          <option value="1536x1152">1536x1152</option>
          <option value="2048x1536">2048x1536</option>
          <option value="2560x1920">2560x1920</option>
          <option value="3072x2304">3072x2304</option>
        </select>
      </div>
    </div>
    <div id="settings-screens" class="settings-page selected">
      <div id="layout-row" class="field">
        <label for="pause-screen-layout">Screen layout</label>
        <select id="pause-screen-layout">
          <option value="single">Single screen</option>
          <option value="focus">Large + side</option>
          <option value="classic">Classic DS</option>
          <option value="side-by-side">Side by side</option>
          <option value="pip">PiP overlay</option>
        </select>
      </div>
      <div class="field">
        <label for="auto-join">Presentation</label>
        <select id="auto-join">
          <option value="automatic">Automatic (PC)</option>
          <option value="manual">Original DS</option>
        </select>
      </div>
      <p id="single-screen-note" class="hint">Single screen is currently manual. Some scenes need both views. Hold M to inspect the upper screen, or press F2 for both.</p>

    </div>
    <div id="settings-map" class="settings-page">
      <div class="field">
        <label for="secondary-size">Minimap / secondary view</label>
        <select id="secondary-size">
          <option value="0">Hidden</option>
          <option value="20">Small (20%)</option>
          <option value="30">Medium (30%)</option>
        </select>
      </div>
      <div class="field">
        <label for="secondary-opacity">Overlay opacity</label>
        <select id="secondary-opacity">
          <option value="100">100%</option>
          <option value="75">75%</option>
          <option value="50">50%</option>
        </select>
      </div>
      <p id="map-shortcut" class="hint">Hold M to view the upper screen. F2 restores both original screens.</p>
    </div>
    <div id="settings-features" class="settings-page">
      <div class="field">
        <label for="unify-cutscenes">Unified cutscenes</label>
        <select id="unify-cutscenes"><option value="on">On</option><option value="off">Off</option></select>
      </div>
      <div class="field">
        <label for="narrative-subtitles">Subtitles over artwork</label>
        <select id="narrative-subtitles"><option value="on">On</option><option value="off">Off</option></select>
      </div>
      <div class="field">
        <label for="hide-secondary">Hide unused screens</label>
        <select id="hide-secondary"><option value="on">On</option><option value="off">Off</option></select>
      </div>
    </div>
    <div id="settings-controls" class="settings-page"></div>
    <div id="settings-audio" class="settings-page">
      <div class="field">
        <label for="master-volume">Master volume</label>
        <div class="range-group">
          <input type="range" id="master-volume" class="slider" min="0" max="100" step="1" value="100" />
          <span id="master-volume-value" class="range-value">100%</span>
        </div>
      </div>
      <div class="field">
        <label for="mute-unfocused">Mute unfocused</label>
        <select id="mute-unfocused">
          <option value="off">Off</option>
          <option value="on">On</option>
        </select>
      </div>
      <div class="field">
        <label for="audio-interp">Audio quality</label>
        <select id="audio-interp">
          <option value="none">Original DS</option>
          <option value="linear">Linear</option>
          <option value="cosine">Cosine</option>
          <option value="cubic">Cubic</option>
          <option value="gaussian">Gaussian</option>
        </select>
      </div>
      <div class="field">
        <label for="output-device">Output device</label>
        <select id="output-device">
          <option value="">System default</option>
        </select>
      </div>
      <div class="field">
        <label for="mic-mode">Microphone</label>
        <select id="mic-mode">
          <option value="automatic">Automatic</option>
          <option value="real">Real mic</option>
          <option value="virtual">Virtual blow</option>
          <option value="hybrid">Hybrid</option>
          <option value="off">Off</option>
        </select>
      </div>
      <div class="field">
        <label for="input-device">Input device</label>
        <select id="input-device">
          <option value="">System default</option>
        </select>
      </div>
      <div class="field">
        <label for="mic-gain">Mic / blow level</label>
        <div class="range-group">
          <input type="range" id="mic-gain" class="slider" min="0" max="200" step="5" value="100" />
          <span id="mic-gain-value" class="range-value">100%</span>
        </div>
      </div>
    </div>
    <div id="settings-window" class="settings-page">
      <div id="display-row" class="field">
        <label for="display">Display mode</label>
        <input type="submit" id="display" value="Windowed" />
      </div>
    </div>
    <input type="submit" id="resume" value="Close menu" />
    <input type="submit" id="leave" value="Return to launcher" />
  </div>
</body>
</rml>
