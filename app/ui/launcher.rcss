/* SPDX-License-Identifier: GPL-3.0-or-later */
body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: #171e1e;
    color: #eff2eb;
    font-family: "Alegreya Sans";
    font-size: 18dp;
    line-height: 24dp;
}

div, h1, h2, p, label { display: block; }
h1, h2, p { margin: 0; font-weight: normal; }

#viewport {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    overflow-x: hidden;
    overflow-y: auto;
}

#layout { margin: 0 auto; max-width: 920dp; padding: 26dp 32dp 28dp; }
#header {
    display: flex;
    align-items: center;
    padding-bottom: 18dp;
    margin-bottom: 24dp;
    border-bottom: 1dp #3a4642;
}

#mark {
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 35dp;
    height: 35dp;
    padding: 6dp;
    border: 1dp #718980;
    border-radius: 7dp;
    background-color: #263532;
    margin-right: 13dp;
}

.screen { height: 8dp; background-color: #b4d0bb; border-radius: 2dp; }
.screen.lower { margin-top: 4dp; background-color: #dbbd7c; }
h1 { font-family: "Cinzel"; font-size: 26dp; line-height: 31dp; color: #f0e9d6; }
h2 { font-size: 23dp; line-height: 28dp; }
.hint { margin-top: 4dp; color: #b3c0b8; font-size: 16dp; }

#content { display: flex; align-items: flex-start; }
#game { flex: 1; min-width: 0; }
#settings {
    box-sizing: border-box;
    flex: 0 0 338dp;
    margin-left: 26dp;
    border-left: 1dp #3a4642;
    padding-left: 22dp;
}

#source { display: flex; align-items: center; margin-top: 15dp; }
#rom {
    flex: 1;
    min-width: 0;
    height: 38dp;
    line-height: 38dp;
    padding: 0 10dp;
    background-color: #111717;
    border: 1dp #414f49;
    border-radius: 4dp;
    color: #b3c0b8;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

#rom.selected { color: #eff2eb; }
#status { min-height: 23dp; margin-top: 8dp; color: #b3c0b8; font-size: 16dp; word-break: break-word; }
#status.error { color: #ffbfaa; }

.field { display: flex; align-items: center; justify-content: space-between; margin-top: 13dp; }
.settings-tabs { display: flex; flex-wrap: wrap; margin-top: 10dp; }
.settings-tabs input[type=submit] { flex: 1 0 auto; min-width: 0; height: 34dp; line-height: 32dp; padding: 0 9dp; margin-right: 5dp; margin-bottom: 5dp; }
#settings-features select { flex-basis: 72dp; }
.settings-tabs input[type=submit].selected { border-color: #aabda6; background-color: #41584d; }
.settings-page { display: none; min-height: 96dp; }
.settings-page.selected { display: block; }
label { margin-right: 9dp; color: #d4ded4; font-size: 16dp; }
select {
    box-sizing: border-box;
    flex: 0 0 148dp;
    height: 36dp;
    padding: 0 8dp;
    font-size: 16dp;
    background-color: #24312e;
    border: 1dp #52645a;
    border-radius: 4dp;
    cursor: pointer;
}

select selectvalue {
    line-height: 33dp;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
select selectarrow {
    width: 0;
    height: 0;
    margin: 14dp 1dp 0 6dp;
    border-top: 5dp #d6e1d7;
    border-right: 4dp transparent;
    border-left: 4dp transparent;
}

select selectbox { background-color: #24312e; border: 1dp #64796b; max-height: 220dp; overflow-y: auto; }
select option { padding: 4dp 8dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
select option:hover, select option:checked { background-color: #42584d; }

#settings-audio .field { margin-top: 4dp; }
#settings-audio label { font-size: 15dp; line-height: 22dp; }
#settings-audio select { flex: 0 0 190dp; height: 27dp; font-size: 15dp; }
#settings-audio select selectvalue { line-height: 25dp; }
#settings-audio select selectarrow { margin: 10dp 1dp 0 6dp; }
#settings-audio select option { font-size: 15dp; }

.range-group {
    display: flex;
    align-items: center;
    flex: 0 0 190dp;
    height: 26dp;
}

input.slider {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    height: 24dp;
    cursor: pointer;
}

input.slider sliderarrowdec,
input.slider sliderarrowinc {
    width: 0;
    height: 0;
}

input.slider slidertrack {
    height: 6dp;
    margin: 9dp 0;
    border-radius: 3dp;
    background-color: #263532;
    border: 1dp #485b52;
}

input.slider sliderbar {
    width: 12dp;
    height: 16dp;
    margin: 4dp 0;
    border-radius: 4dp;
    background-color: #c7dbb9;
    border: 1dp #eff2eb;
}

input.slider:hover sliderbar,
input.slider:focus sliderbar {
    background-color: #eed08c;
    border-color: #eed08c;
}

input.slider:disabled { cursor: unavailable; }
input.slider:disabled slidertrack { background-color: #1c2523; border-color: #36433d; }
input.slider:disabled sliderbar { background-color: #5e6f66; border-color: #77887f; }

.range-value {
    display: block;
    flex: 0 0 42dp;
    margin-left: 6dp;
    text-align: right;
    font-size: 15dp;
    line-height: 24dp;
    color: #eff2eb;
}

.range-value.disabled { color: #9eafa6; }

input[type=submit] {
    display: block;
    box-sizing: border-box;
    height: 40dp;
    border: 1dp #5f7668;
    border-radius: 4dp;
    background-color: #263731;
    color: #f0f3eb;
    line-height: 38dp;
    text-align: center;
    cursor: pointer;
}

input[type=submit]:hover { background-color: #394d43; }
input[type=submit]:focus, select:focus { border-color: #eed08c; }
#browse { flex: 0 0 92dp; margin-left: 8dp; }
#play { width: 126dp; margin-top: 13dp; border-color: #c7dbb9; background-color: #c7dbb9; color: #18231d; }
#play:hover { background-color: #dfebd5; }
input[type=submit]:disabled, #play:disabled, select:disabled {
    background-color: #202a28;
    color: #9eafa6;
    border-color: #404e47;
    cursor: unavailable;
}

#build-panel { border-top: 1dp #3a4642; margin-top: 20dp; padding-top: 15dp; }
#build-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; }
#cache-summary { color: #b3c0b8; font-size: 16dp; margin-left: 8dp; }
#build-actions { display: flex; flex-wrap: wrap; margin-top: 9dp; }
#build-actions input { min-width: 82dp; padding: 0 10dp; margin: 0 8dp 8dp 0; }
#build-progress { display: none; margin: 4dp 0 10dp; font-size: 16dp; }
#build-progress.visible { display: block; }
#build-progress-heading { display: flex; flex-wrap: wrap; justify-content: space-between; }
#build-stage { margin-right: 10dp; }
#build-elapsed { color: #b3c0b8; }
#build-meter { display: block; width: 100%; height: 7dp; margin: 4dp 0; background-color: #35453e; }
#build-meter fill { background-color: #c7dbb9; }
#build-activity { color: #c7dbb9; }
#build-details { display: none; padding: 9dp 12dp; background-color: #111717; border: 1dp #414f49; border-radius: 4dp; }
#build-details.visible { display: block; }
#build-steps { max-height: 150dp; overflow-y: auto; word-break: break-word; font-size: 16dp; color: #d4ded4; }
#build-steps p { margin-bottom: 4dp; }

scrollbarvertical { width: 10dp; background-color: #1c2724; }
scrollbarvertical sliderbar { background-color: #62776c; min-height: 22dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }

.control-pages { display: flex; flex-wrap: wrap; margin-bottom: 6dp; }
#content.controls-open #game { display: none; }
#content.controls-open #settings { flex: 1; margin: 0; padding: 0; border: 0; }
.controls-columns { display: flex; align-items: flex-start; }
.controls-setup { flex: 0 0 38%; min-width: 0; margin-right: 24dp; }
.controls-editor { flex: 1; min-width: 0; }
#pause-panel .controls-columns { display: block; }
#pause-panel .controls-setup { margin-right: 0; }
.control-pages input { flex: 1; min-width: 100dp; margin: 0 4dp 5dp 0; padding: 0 6dp; font-size: 16dp; }
.control-pages input.selected { background-color: #41584d; border-color: #aabda6; }
.binding-heading, .binding-row { display: flex; align-items: center; margin-top: 5dp; }
.binding-heading { color: #b3c0b8; font-size: 15dp; }
.binding-heading span { display: block; flex: 0 0 90dp; margin-left: 5dp; text-align: center; }
.binding-heading span:first-child { flex: 1; margin-left: 0; text-align: left; }
.binding-row label { flex: 1; min-width: 65dp; padding-right: 5dp; font-size: 16dp; }
.binding-row input { flex: 0 0 90dp; min-width: 0; margin-left: 5dp; padding: 0 3dp; font-size: 15dp; }
#controls-bindings { max-height: 278dp; overflow-y: auto; padding-right: 6dp; }
#controls-reset { width: 100%; margin-top: 8dp; font-size: 16dp; }
#controls-message, #controls-scope, #controls-menu-help { font-size: 15dp; line-height: 20dp; margin-bottom: 6dp; }
#controls-device { margin-bottom: 8dp; word-break: break-word; }
#controls-conflict { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%;
    z-index: 100; background-color: #080e0ee8; align-items: center; justify-content: center; }
#controls-conflict-panel { box-sizing: border-box; width: 470dp; max-width: 92%; max-height: 92%; overflow-y: auto;
    padding: 24dp; border: 2dp #b8cba7; border-radius: 6dp; background-color: #192620; }
#controls-conflict-panel h2 { font-family: Cinzel; font-size: 20dp; color: #eed08c; margin-bottom: 15dp; }
#controls-conflict-panel p { font-size: 19dp; line-height: 25dp; margin-bottom: 16dp; }
.conflict-actions { display: flex; flex-wrap: wrap; }
.conflict-actions input { flex: 1; min-width: 120dp; margin: 4dp; padding: 0 8dp; }
#controls-conflict-replace { background-color: #c7dbb9; color: #18231d; }

@media (max-width: 659dp) {
    .controls-columns { display: block; }
    .controls-setup { margin-right: 0; }
    #layout { padding: 22dp 24dp 26dp; }
    #header { padding-bottom: 16dp; margin-bottom: 21dp; }
    h1 { font-size: 21dp; line-height: 27dp; }
    #content { display: block; }
    #settings { margin: 23dp 0 0; padding: 17dp 0 0; border-left: 0; border-top: 1dp #3a4642; }
    .field { max-width: 340dp; }
    select { flex-basis: 130dp; }
    #settings-audio select, .range-group { flex-basis: 190dp; }
    #build-panel { margin-top: 23dp; }
}
