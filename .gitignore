# Local environments and downloaded third-party tools
.venv/
.tools/
__pycache__/

# Everything generated by the proof of concept (may contain data derived from a user's ROM)
poc/out/

# Game data must never be committed (see AGENTS.md and docs/legal/)
*.nds
*.srl
*.sav
*.dsv
*.bmp

# Reconstructed Spirit Tracks source: private until legal review (ADR-0001 rev. 3, docs/legal/). game/st/config/ (facts:
# addresses and public SDK names) and game/st/hooks/ (our glue code) are tracked.
game/st/*
!game/st/config/
!game/st/hooks/

# Everything built from a user's ROM (docs/BUILDING.md): recompiled C, game modules, saves, screenshots, hash logs
/build/

# M1a spike: raw results (logs, test executables, generated C of our synthetic cartridge); summarised in docs/research/M1A_SPIKE.md
spike/m1a/results/

# Legal research notes and reports (private until the maintainer decides; docs/PUBLISHING.md)
research_notes/
reports/
